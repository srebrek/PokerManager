@using Contracts.Api.Gameplay
@using static Web.Frontend.Features.Game.SeatCard

@* padding for the action bar: 8px + two 36px rows + 8px gutter + 8px *@
<MudStack data-testid="hand-panel" Style="padding-bottom: 96px">
    <MudButton OnClick="@(() => OnFinish.InvokeAsync(_selectedWinnerId))" data-testid="finish-hand">
        Finish Hand
    </MudButton>

    <MudButton OnClick="OnAbort" data-testid="abort-hand">
        Abort Hand
    </MudButton>

    <MudStack StretchItems="StretchItems.All" Row>
        <MudPaper Class="pa-4 align-content-center">
            <MudText Typo="Typo.caption">Pot</MudText>
            <MudText Typo="Typo.h5" data-testid="pot">@Hand.Pot</MudText>
        </MudPaper>

        <MudPaper Class="pa-4">
            <MudText Typo="Typo.caption">Street</MudText>
            <MudText Typo="Typo.h5" data-testid="street">@Hand.Street.ToString()</MudText>
        </MudPaper>
    </MudStack>

    <MudStack>
        @foreach (SeatCardModel seatCardInput in _seats)
        {
            <SeatCard
                Model="seatCardInput"
                OnClick="SetWinnerId"
                IsSelected="@(seatCardInput.ParticipantId == _selectedWinnerId)">
            </SeatCard>
        }
    </MudStack>
</MudStack>

<MudPaper
    Outlined
    Style="position: fixed;
           inset: auto 0 0 0;
           padding: 8px 8px calc(var(--mud-appbar-height) + 8px);
           z-index: var(--mud-zindex-appbar);"
    data-testid="hand-action-bar">
    <MudGrid Spacing="2">
        <MudItem xs="3">
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" FullWidth Disabled data-testid="action-all-in">
                All-in
            </MudButton>
        </MudItem>
        <MudItem xs="3">
            <MudButton
                Variant="Variant.Filled"
                Color="Color.Secondary"
                FullWidth
                OnClick="@(() => OnAction.InvokeAsync(new(HandActionType.Fold)))"
                data-testid="action-fold">
                Fold
            </MudButton>
        </MudItem>
        <MudItem xs="3">
            <MudButton
                Variant="Variant.Filled"
                Color="Color.Warning"
                FullWidth
                OnClick="@(() => OnAction.InvokeAsync(new(HandActionType.Check)))"
                data-testid="action-check">
                Check
            </MudButton>
        </MudItem>
        <MudItem xs="3">
            <MudButton
                Variant="Variant.Filled"
                Color="Color.Warning"
                FullWidth
                OnClick="@(() => OnAction.InvokeAsync(new(HandActionType.Call)))"
                data-testid="action-call">
                Call
            </MudButton>
        </MudItem>

        <MudItem xs="3">
            <MudPaper Height="100%" Width="100%" Outlined Class="align-content-center">
                <MudText Align="Align.Center" data-testid="selected-amount">
                    @_selectedAmount
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="3">
            <MudButton
                Variant="Variant.Outlined"
                Color="Color.Primary"
                FullWidth
                OnClick="@(() => IncrementSelectedAmount(SmallBlind))"
                data-testid="amount-increment">
                +@SmallBlind
            </MudButton>
        </MudItem>
        <MudItem xs="3">
            <MudButton
                Variant="Variant.Outlined"
                Color="Color.Primary"
                FullWidth
                OnClick="@(() => IncrementSelectedAmount(-SmallBlind))"
                data-testid="amount-decrement">
                -@SmallBlind
            </MudButton>
        </MudItem>
        <MudItem xs="3">
            <MudButton
                Variant="Variant.Filled"
                Color="Color.Primary"
                FullWidth
                OnClick="@(() =>
                    OnAction.InvokeAsync(new(_isBet ? HandActionType.Bet : HandActionType.Raise, _selectedAmount)))"
                data-testid="action-bet-raise">
                @(_isBet ? "Bet" : "Raise")
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@code {
    [Parameter]
    [EditorRequired]
    public required GetHandStateResponse Hand { get; set; }

    [Parameter]
    [EditorRequired]
    public required IReadOnlyList<GameStateParticipant> Participants { get; set; }

    [Parameter]
    [EditorRequired]
    public int SmallBlind { get; set; }

    [Parameter]
    [EditorRequired]
    public EventCallback<HandActionSelected> OnAction { get; set; }

    [Parameter]
    [EditorRequired]
    public EventCallback<Guid> OnFinish { get; set; }

    [Parameter]
    [EditorRequired]
    public EventCallback OnAbort { get; set; }

    [Parameter]
    public Guid? MyParticipantId { get; set; }

    private List<SeatCardModel> _seats = [];
    private HandStateSeat? _mySeat;
    private int? _amountToCall;
    private int _selectedAmount = 0;
    private bool _isBet;
    private Guid _selectedWinnerId;

    protected override void OnParametersSet()
    {
        _seats = Hand.Seats.Select(s => new SeatCardModel(
            s.ParticipantId,
            Participants.Single(p => p.Id == s.ParticipantId).Name,
            s.RemainingStack,
            s.StreetContribution,
            s.State,
            s.ParticipantId == MyParticipantId))
            .ToList();

        _mySeat = Hand.Seats.SingleOrDefault(s => s.ParticipantId == MyParticipantId);
        if (_mySeat is not null)
        {
            _amountToCall = Hand.Seats.Max(s => s.StreetContribution - _mySeat.StreetContribution);
        }

        _isBet = _amountToCall is 0;
    }

    private void IncrementSelectedAmount(int value) => _selectedAmount += value;

    private void SetWinnerId(Guid winnerId) =>
        _selectedWinnerId = _selectedWinnerId != winnerId ? winnerId : Guid.Empty;

    public readonly record struct HandActionSelected(HandActionType Type, int? AmountTo = null);
}
