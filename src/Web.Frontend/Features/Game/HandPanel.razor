@using Contracts.Api.Gameplay
@using static Web.Frontend.Features.Game.SeatCard

<MudStack data-testid="hand-panel">
    <MudButton OnClick="@(() => OnFinish(_selectedWinnerId))" data-testid="finish-hand">
        Finish Hand
    </MudButton>

    <MudButton OnClick="OnAbort" data-testid="abort-hand">
        Abort Hand
    </MudButton>

    <MudStack StretchItems="StretchItems.All" Row>
        <MudPaper Class="pa-4 align-content-center">
            <MudText Typo="Typo.caption">Pot</MudText>
            <MudText Typo="Typo.h5" data-testid="pot">@Hand.Pot</MudText>
        </MudPaper>

        <MudPaper Class="pa-4">
            <MudText Typo="Typo.caption">Street</MudText>
            <MudText Typo="Typo.h5" data-testid="street">@Hand.Street.ToString()</MudText>
        </MudPaper>
    </MudStack>

    <MudStack>
        @foreach (SeatCardModel seatCardInput in _seats)
        {
            <SeatCard
                Model="seatCardInput"
                OnClick="SetWinnerId"
                IsSelected="@(seatCardInput.ParticipantId == _selectedWinnerId)">
            </SeatCard>
        }
    </MudStack>

    <MudStack Row>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Disabled data-testid="action-all-in">
            All-in
        </MudButton>

        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="OnFold" data-testid="action-fold">
            Fold
        </MudButton>

        <MudButton Variant="Variant.Filled" Color="Color.Warning" OnClick="OnCheck" data-testid="action-check">
            Check
        </MudButton>

        <MudButton Variant="Variant.Filled" Color="Color.Warning" OnClick="OnCall" data-testid="action-call">
            Call
        </MudButton>
    </MudStack>

    <MudStack Row>
        <MudPaper>
            <MudText data-testid="selected-amount">
                @_selectedAmount
            </MudText>
        </MudPaper>

        <MudButton
            Variant="Variant.Outlined"
            Color="Color.Primary"
            OnClick="@(() => IncrementSelectedAmount(SmallBlind))"
            data-testid="amount-increment">
            +@SmallBlind
        </MudButton>

        <MudButton
            Variant="Variant.Outlined"
            Color="Color.Primary"
            OnClick="@(() => IncrementSelectedAmount(-SmallBlind))"
            data-testid="amount-decrement">
            -@SmallBlind
        </MudButton>

        <MudButton
            Variant="Variant.Filled"
            Color="Color.Primary"
            OnClick="@(() => _isBet ? OnBet(_selectedAmount) : OnRaise(_selectedAmount))"
            data-testid="action-bet-raise">
            @(_isBet ? "Bet" : "Raise")
        </MudButton>
    </MudStack>
</MudStack>

@code {
    [Parameter]
    [EditorRequired]
    public required GetHandStateResponse Hand { get; set; }

    [Parameter]
    [EditorRequired]
    public required IReadOnlyList<GameStateParticipant> Participants { get; set; }

    [Parameter]
    [EditorRequired]
    public int SmallBlind { get; set; }

    [Parameter]
    [EditorRequired]
    public Func<Task> OnFold { get; set; }

    [Parameter]
    [EditorRequired]
    public Func<Task> OnCheck { get; set; }

    [Parameter]
    [EditorRequired]
    public Func<Task> OnCall { get; set; }

    [Parameter]
    [EditorRequired]
    public Func<int, Task> OnBet { get; set; }

    [Parameter]
    [EditorRequired]
    public Func<int, Task> OnRaise { get; set; }

    [Parameter]
    [EditorRequired]
    public Func<Guid, Task> OnFinish { get; set; }

    [Parameter]
    [EditorRequired]
    public EventCallback OnAbort { get; set; }

    [Parameter]
    public Guid? MyParticipantId { get; set; }

    private List<SeatCardModel> _seats = [];
    private HandStateSeat? _mySeat;
    private int? _amountToCall;
    private int _selectedAmount = 0;
    private bool _isBet;
    private Guid _selectedWinnerId;

    protected override void OnParametersSet()
    {
        _seats = Hand.Seats.Select(s => new SeatCardModel(
            s.ParticipantId,
            Participants.Single(p => p.Id == s.ParticipantId).Name,
            s.RemainingStack,
            s.StreetContribution,
            s.State,
            s.ParticipantId == MyParticipantId))
            .ToList();

        _mySeat = Hand.Seats.SingleOrDefault(s => s.ParticipantId == MyParticipantId);
        if (_mySeat is not null)
        {
            _amountToCall = Hand.Seats.Max(s => s.StreetContribution - _mySeat.StreetContribution);
        }

        _isBet = _amountToCall is 0;
    }

    private void IncrementSelectedAmount(int value) => _selectedAmount += value;

    private void SetWinnerId(Guid winnerId) =>
        _selectedWinnerId = _selectedWinnerId != winnerId ? winnerId : Guid.Empty;
}
