@using Contracts.Api.Gameplay
@using static Web.Frontend.Features.Game.SeatCard

@* padding for the action bar: 8px + two 36px rows + 8px gutter + 8px, and the chip bar: 8px + 36px + 8px *@
<MudStack data-testid="hand-panel" Style="padding-bottom: 148px">
    <MudStack Row>
        <MudButton OnClick="OnAbort" FullWidth data-testid="abort-hand">
            Abort Hand
        </MudButton>

        <MudButton OnClick="OnUndo" FullWidth data-testid="undo-action">
            Undo
        </MudButton>
    </MudStack>

    <MudStack StretchItems="StretchItems.All" Row>
        <MudPaper
            Class="pa-4 align-content-center"
            @onclick="@(() => OnPotsRequested.InvokeAsync())"
            data-testid="pot-tile">
            <MudText Typo="Typo.caption">Pot</MudText>
            <MudText Typo="Typo.h5" data-testid="pot">@Hand.Pots.Sum(p => p.Amount)</MudText>
        </MudPaper>

        <MudPaper Class="pa-4">
            <MudText Typo="Typo.caption">Street</MudText>
            <MudText Typo="Typo.h5" data-testid="street">@Hand.Street.ToString()</MudText>
        </MudPaper>
    </MudStack>

    <MudStack>
        @foreach (SeatCardModel seatCardInput in _seats)
        {
            <SeatCard
                Model="seatCardInput"
                IsSelected="@(_selectedParticipantId == seatCardInput.ParticipantId)"
                IsSelectable="@(seatCardInput.State is SeatState.Active)"
                OnClick="SelectSeat" />
        }
    </MudStack>
</MudStack>

<div style="
    position: fixed;
    inset: auto 0 0 0;
    padding-bottom: var(--mud-appbar-height);
    z-index: var(--mud-zindex-appbar);">
    <MudPaper Square Class="pa-2" data-testid="hand-action-bar">
        <MudGrid Spacing="2">
            <MudItem xs="3">
                <MudButton
                    Variant="Variant.Filled"
                    Color="Color.Secondary"
                    FullWidth
                    OnClick="@(() => SubmitAsync(HandActionType.AllIn))"
                    data-testid="action-all-in">
                    All-in
                </MudButton>
            </MudItem>
            <MudItem xs="3">
                <MudButton
                    Variant="Variant.Filled"
                    Color="Color.Secondary"
                    FullWidth
                    OnClick="@(() => SubmitAsync(HandActionType.Fold))"
                    data-testid="action-fold">
                    Fold
                </MudButton>
            </MudItem>
            <MudItem xs="3">
                <MudButton
                    Variant="Variant.Filled"
                    Color="Color.Warning"
                    FullWidth
                    OnClick="@(() => SubmitAsync(HandActionType.Check))"
                    data-testid="action-check">
                    Check
                </MudButton>
            </MudItem>
            <MudItem xs="3">
                <MudButton
                    Variant="Variant.Filled"
                    Color="Color.Warning"
                    FullWidth
                    OnClick="@(() => SubmitAsync(HandActionType.Call))"
                    data-testid="action-call">
                    Call
                </MudButton>
            </MudItem>

            <MudItem xs="3">
                <MudPaper Height="100%" Width="100%" Outlined Class="align-content-center">
                    <MudText Align="Align.Center" data-testid="selected-amount">
                        @_selectedAmount
                    </MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="3">
                <MudButton
                    Variant="Variant.Outlined"
                    Color="Color.Primary"
                    FullWidth
                    OnClick="@(() => IncrementSelectedAmount(SmallBlind))"
                    data-testid="amount-increment">
                    +@SmallBlind
                </MudButton>
            </MudItem>
            <MudItem xs="3">
                <MudButton
                    Variant="Variant.Outlined"
                    Color="Color.Primary"
                    FullWidth
                    OnClick="@(() => IncrementSelectedAmount(-SmallBlind))"
                    data-testid="amount-decrement">
                    -@SmallBlind
                </MudButton>
            </MudItem>
            <MudItem xs="3">
                <MudButton
                    Variant="Variant.Filled"
                    Color="Color.Primary"
                    FullWidth
                    OnClick="@(() => SubmitAsync(IsBet ? HandActionType.Bet : HandActionType.Raise, _selectedAmount))"
                    data-testid="action-bet-raise">
                    @(IsBet ? "Bet" : "Raise")
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Square Class="pa-2" data-testid="chip-bar">
        <MudStack Row Spacing="2">
            <MudButton
                Variant="Variant.Filled"
                Class="flex-1"
                Style="background-color: #1a1a1a; color: #ffffff;"
                OnClick="@(() => IncrementSelectedAmount(500))"
                data-testid="chip-500">
                500
            </MudButton>
            <MudButton
                Variant="Variant.Filled"
                Class="flex-1"
                Style="background-color: #1f7a3d; color: #ffffff;"
                OnClick="@(() => IncrementSelectedAmount(200))"
                data-testid="chip-200">
                200
            </MudButton>
            <MudButton
                Variant="Variant.Filled"
                Class="flex-1"
                Style="background-color: #1c4f9c; color: #ffffff;"
                OnClick="@(() => IncrementSelectedAmount(100))"
                data-testid="chip-100">
                100
            </MudButton>
            <MudButton
                Variant="Variant.Filled"
                Class="flex-1"
                Style="background-color: #c62828; color: #ffffff;"
                OnClick="@(() => IncrementSelectedAmount(50))"
                data-testid="chip-50">
                50
            </MudButton>
            <MudButton
                Variant="Variant.Filled"
                Class="flex-1"
                Style="background-color: #f5f5f5; color: #1a1a1a;"
                OnClick="@(() => IncrementSelectedAmount(25))"
                data-testid="chip-25">
                25
            </MudButton>
        </MudStack>
    </MudPaper>
</div>

@code {
    [Parameter]
    [EditorRequired]
    public required GetHandStateResponse Hand { get; set; }

    [Parameter]
    [EditorRequired]
    public required IReadOnlyList<GameStateParticipant> Participants { get; set; }

    [Parameter]
    [EditorRequired]
    public int SmallBlind { get; set; }

    [Parameter]
    [EditorRequired]
    public EventCallback<HandActionSelected> OnAction { get; set; }

    [Parameter]
    [EditorRequired]
    public EventCallback OnPotsRequested { get; set; }

    [Parameter]
    [EditorRequired]
    public EventCallback OnAbort { get; set; }

    [Parameter]
    [EditorRequired]
    public EventCallback OnUndo { get; set; }

    [Parameter]
    public Guid? MyParticipantId { get; set; }

    private List<SeatCardModel> _seats = [];
    private Guid? _selectedParticipantId;
    private Guid _handId;
    private bool _isHost;
    private int _selectedAmount = 0;

    protected override void OnParametersSet()
    {
        if (_handId != Hand.HandId)
        {
            _handId = Hand.HandId;
            _selectedParticipantId = null;
        }

        _seats = Hand.Seats.Select(s => new SeatCardModel(
            s.ParticipantId,
            Participants.Single(p => p.Id == s.ParticipantId).Name,
            s.RemainingStack,
            s.StreetContribution,
            s.State,
            s.ParticipantId == MyParticipantId))
            .ToList();

        _isHost = Participants.Any(p => p.Id == MyParticipantId && p.IsHost);
    }

    private Guid? ActingParticipantId => _selectedParticipantId ?? MyParticipantId;

    private HandStateSeat? ActingSeat =>
        Hand.Seats.SingleOrDefault(s => s.ParticipantId == ActingParticipantId);

    private int? AmountToCall => ActingSeat is { } actingSeat
        ? Hand.Seats.Max(s => s.StreetContribution - actingSeat.StreetContribution)
        : null;

    private bool IsBet => AmountToCall is 0;

    private void SelectSeat(Guid participantId)
    {
        if (!_isHost)
        {
            return;
        }

        _selectedParticipantId = _selectedParticipantId != participantId ? participantId : null;
    }

    private Task SubmitAsync(HandActionType type, int? amountTo = null)
    {
        if (ActingParticipantId is not { } actingParticipantId)
        {
            return Task.CompletedTask;
        }

        _selectedParticipantId = null;

        return OnAction.InvokeAsync(new(actingParticipantId, type, amountTo));
    }

    private void IncrementSelectedAmount(int value) => _selectedAmount += value;

    public readonly record struct HandActionSelected(
        Guid ActingParticipantId, HandActionType Type, int? AmountTo = null);
}
