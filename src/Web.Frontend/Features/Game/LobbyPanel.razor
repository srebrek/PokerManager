@using System.ComponentModel.DataAnnotations
@using Contracts.Api.Gameplay

<MudStack data-testid="lobby-panel">
    <MudStack StretchItems="StretchItems.All" Row>
        <MudPaper Class="pa-4 align-content-center">
            <MudText Typo="Typo.caption">Join Code</MudText>
            <MudText Typo="Typo.h5" data-testid="join-code">@Game.JoinCode</MudText>
        </MudPaper>

        <MudPaper Class="pa-4">
            <MudText>Rules</MudText>
            <MudText>Big Blind: @Game.BigBlind</MudText>
            <MudText>Small Blind: @Game.SmallBlind</MudText>
        </MudPaper>
    </MudStack>

    <MudList T="Guid" ReadOnly Dense>
        @foreach (GameStateParticipant participant in Game.Participants)
        {
            <MudListItem Value="participant.Id">
                <MudStack Row AlignItems="AlignItems.Center" data-testid="participant-row">
                    <MudText
                        data-testid="participant-name"
                        Color="@(MyParticipantId == participant.Id
                        ? Color.Primary
                        : Color.Inherit)">
                        @participant.Name
                    </MudText>

                    <MudChip
                        T="string"
                        Variant="Variant.Text"
                        Class="@(participant.IsHost ? "visible" : "invisible")">
                        Host
                    </MudChip>

                    <MudSpacer />
                    <MudText data-testid="participant-chips">@participant.Chips</MudText>
                </MudStack>
            </MudListItem>
        }
    </MudList>

    @if (MyParticipantId is null)
    {
        <EditForm Model="@_model" OnValidSubmit="OnValidSubmit">
            <DataAnnotationsValidator />

            <MudStack Row AlignItems="AlignItems.Center">
                <MudTextField @bind-Value="_model.Name" For="@(() => _model.Name)" Label="Your Name" />

                <MudButton
                    ButtonType="ButtonType.Submit"
                    Variant="Variant.Filled"
                    Color="Color.Primary"
                    data-testid="join-as-new-player">
                    Join as new player
                </MudButton>
            </MudStack>
        </EditForm>
    }
</MudStack>

@code {
    [Parameter]
    [EditorRequired]
    public GameStateResponse Game { get; set; }

    [Parameter]
    [EditorRequired]
    public Guid? MyParticipantId { get; set; }

    [Parameter]
    [EditorRequired]
    public EventCallback<string> OnParticipantCreated { get; set; }

    private readonly AddParticipantModel _model = new();

    private Task OnValidSubmit() => OnParticipantCreated.InvokeAsync(_model.Name);

    internal sealed class AddParticipantModel
    {
        [Required]
        public string Name { get; set; } = string.Empty;
    }
}
