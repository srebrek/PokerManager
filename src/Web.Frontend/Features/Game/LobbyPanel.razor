@using Contracts.Api.Gameplay

@* padding for the host action bar: 8px + two 36px rows + 16px gutter + 8px *@
<MudStack data-testid="lobby-panel" Style="@(_isHost ? "padding-bottom: 104px" : null)">
    <MudStack StretchItems="StretchItems.All" Row>
        <MudPaper Class="pa-4 align-content-center">
            <MudText Typo="Typo.caption">Join Code</MudText>
            <MudText Typo="Typo.h5" data-testid="join-code">@Game.JoinCode</MudText>
        </MudPaper>

        <MudPaper Class="pa-4">
            <MudText Typo="Typo.caption">Rules</MudText>
            <MudText>Big Blind: @Game.BigBlind</MudText>
            <MudText>Small Blind: @Game.SmallBlind</MudText>
        </MudPaper>
    </MudStack>

    @foreach (GameStateParticipant participant in Game.Participants)
    {
        <ParticipantCard
            Participant="participant"
            IsMe="@(MyParticipantId == participant.Id)"
            IsSelected="@(_selectedParticipantId == participant.Id)"
            OnClick="SelectParticipant" />
    }

    @if (MyParticipantId is null)
    {
        <MudStack Row AlignItems="AlignItems.Center">
            <MudTextField
                @bind-Value="_name"
                @bind-Value:after="ClearSelectionWhenNamed"
                Immediate
                Label="Your Name" />

            <MudButton
                OnClick="JoinAsync"
                Disabled="@(!CanJoin)"
                Variant="Variant.Filled"
                Color="Color.Primary"
                data-testid="join-as-new-player">
                Join
            </MudButton>
        </MudStack>
    }
</MudStack>

@if (_isHost)
{
    <MudPaper
        Outlined
        Style="position: fixed;
               inset: auto 0 0 0;
               padding: 8px 8px calc(var(--mud-appbar-height) + 8px);
               z-index: var(--mud-zindex-appbar);">
        <MudGrid Spacing="2">
            <MudItem xs="3">
                <MudButton
                    Variant="Variant.Filled"
                    Color="Color.Primary"
                    FullWidth
                    Disabled="@(_selectedParticipantId is null)"
                    OnClick="@(() => OnRebuyRequested.InvokeAsync(_selectedParticipantId!.Value))"
                    data-testid="host-rebuy">
                    Rebuy
                </MudButton>
            </MudItem>

            <MudItem xs="3">
                <MudButton
                    Variant="Variant.Filled"
                    Color="Color.Primary"
                    FullWidth
                    StartIcon="@Icons.Material.Filled.ArrowDownward"
                    OnClick="@(() => OnMoveDownRequested.InvokeAsync(_selectedParticipantId))">
                    Move
                </MudButton>
            </MudItem>

            <MudItem xs="3">
                <MudButton
                    Variant="Variant.Filled"
                    Color="Color.Primary"
                    FullWidth
                    Disabled="@(_selectedParticipantId is null)"
                    OnClick="ToggleSittingOutAsync">
                    @(SelectedSitsOut ? "Sit-In" : "Sit-Out")
                </MudButton>
            </MudItem>

            <MudItem xs="3">
                <MudButton
                    Variant="Variant.Filled"
                    Color="Color.Primary"
                    FullWidth
                    StartIcon="@Icons.Material.Filled.Album"
                    Disabled="@(!CanMoveDealerButton)"
                    OnClick="@(() => OnDealerButtonRequested.InvokeAsync(_selectedParticipantId!.Value))">
                    Dealer
                </MudButton>
            </MudItem>

            <MudItem xs="3">
                <MudButton
                    Variant="Variant.Filled"
                    Color="Color.Primary"
                    FullWidth
                    OnClick="@(() => OnRulesRequested.InvokeAsync())">
                    Rules
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>
}

@code {
    [Parameter, EditorRequired]
    public GameStateResponse Game { get; set; }

    [Parameter, EditorRequired]
    public Guid? MyParticipantId { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<string> OnParticipantCreated { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<Guid> OnParticipantClaimed { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<Guid> OnRebuyRequested { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<Guid?> OnMoveDownRequested { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<SittingOutRequested> OnSittingOutRequested { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<Guid> OnDealerButtonRequested { get; set; }

    [Parameter, EditorRequired]
    public EventCallback OnRulesRequested { get; set; }

    public readonly record struct SittingOutRequested(Guid ParticipantId, bool IsSittingOut);

    private string _name = string.Empty;
    private Guid? _selectedParticipantId;
    private bool _isHost;

    protected override void OnParametersSet() =>
        _isHost = Game.Participants.Any(p => p.Id == MyParticipantId && p.IsHost);

    private bool CanJoin => !string.IsNullOrWhiteSpace(_name) || _selectedParticipantId is not null;

    private GameStateParticipant? SelectedParticipant =>
        Game.Participants.FirstOrDefault(p => p.Id == _selectedParticipantId);

    private bool SelectedSitsOut => SelectedParticipant?.IsSittingOut is true;

    private bool CanMoveDealerButton => SelectedParticipant is { IsDealer: false, IsSittingOut: false };

    private Task ToggleSittingOutAsync() =>
        SelectedParticipant is { } participant
            ? OnSittingOutRequested.InvokeAsync(new(participant.Id, !participant.IsSittingOut))
            : Task.CompletedTask;

    private void SelectParticipant(Guid participantId)
    {
        _selectedParticipantId = _selectedParticipantId != participantId ? participantId : null;
        _name = string.Empty;
    }

    private void ClearSelectionWhenNamed()
    {
        if (!string.IsNullOrWhiteSpace(_name))
        {
            _selectedParticipantId = null;
        }
    }

    private Task JoinAsync()
    {
        if (!string.IsNullOrWhiteSpace(_name))
        {
            return OnParticipantCreated.InvokeAsync(_name);
        }

        return _selectedParticipantId is { } participantId
            ? OnParticipantClaimed.InvokeAsync(participantId)
            : Task.CompletedTask;
    }
}
