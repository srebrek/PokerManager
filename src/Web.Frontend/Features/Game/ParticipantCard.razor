@using Contracts.Api.Gameplay

<MudPaper>
    <MudButton
        OnClick="ClickAsync"
        Variant="Variant.Outlined"
        Color="@(IsSelected ? Color.Warning : Color.Inherit)"
        FullWidth
        data-testid="participant-row">
        <MudStack
            Row
            AlignItems="AlignItems.Center"
            Spacing="2"
            Class="flex-grow-1">
            <MudText Color="@(IsMe ? Color.Primary : Color.Inherit)" data-testid="participant-name">
                @Participant.Name
            </MudText>

            @if (Participant.IsHost)
            {
                <MudChip
                    T="string"
                    Variant="Variant.Text">
                    Host
                </MudChip>
            }

            @if (Participant.IsDealer)
            {
                <MudChip
                    T="string"
                    Variant="Variant.Text"
                    data-testid="participant-dealer">
                    Dealer
                </MudChip>
            }

            @if (Participant.IsSittingOut)
            {
                <MudChip
                    T="string"
                    Variant="Variant.Text"
                    data-testid="participant-sitting-out">
                    Sitting Out
                </MudChip>
            }

            <MudSpacer />

            <MudText data-testid="participant-chips">@Participant.Chips</MudText>
        </MudStack>
    </MudButton>
</MudPaper>

@code {
    [Parameter]
    [EditorRequired]
    public required GameStateParticipant Participant { get; set; }

    [Parameter]
    [EditorRequired]
    public bool IsMe { get; set; }

    [Parameter]
    [EditorRequired]
    public bool IsSelected { get; set; }

    [Parameter]
    [EditorRequired]
    public EventCallback<Guid> OnClick { get; set; }

    private async Task ClickAsync() => await OnClick.InvokeAsync(Participant.Id);
}
