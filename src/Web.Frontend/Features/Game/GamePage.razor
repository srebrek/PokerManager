@page "/games/{GameId:guid}"

@using Contracts.Api.Gameplay

@implements IDisposable

@inject IGameplayApi GameplayApi
@inject ParticipantSession Session
@inject ISnackbar Snackbar
@inject GameHubConnection HubConnection

<PageTitle>Game</PageTitle>

<MudContainer>
    @switch (_state)
    {
        case Loading:
            <MudSkeleton />
            break;
        case Loaded loaded:
            <MudStack>
                <MudButton
                    OnClick="LoadAsync"
                    Variant="Variant.Filled"
                    Color="Color.Primary"
                    data-testid="refresh">
                    Refresh
                </MudButton>

                @if (loaded.Hand is null)
                {
                    <MudPaper Class="pa-8 d-flex justify-center" data-testid="no-hand">
                        <MudText Typo="Typo.h6">No hand in progress</MudText>
                    </MudPaper>

                    <LobbyPanel
                        Game="loaded.Game"
                        MyParticipantId="@Session.ParticipantIdFor(GameId)"
                        OnGameFinished="FinishGameAsync"
                        OnParticipantCreated="CreateParticipantAsync"/>

                    <MudButton OnClick="StartHandAsync" data-testid="start-hand">
                        Start Hand
                    </MudButton>
                }
                else
                {
                    <HandPanel
                        Hand="loaded.Hand"
                        SmallBlind="loaded.Game.SmallBlind"
                        Participants="loaded.Game.Participants"
                        OnFold="@(() => RecordActionAsync(loaded.Hand.HandId, HandActionType.Fold, null))"
                        OnCheck="@(() => RecordActionAsync(loaded.Hand.HandId, HandActionType.Check, null))"
                        OnCall="@(() => RecordActionAsync(loaded.Hand.HandId, HandActionType.Call, null))"
                        OnBet="@((int amountTo) =>
                            RecordActionAsync(loaded.Hand.HandId, HandActionType.Bet, amountTo))"
                        OnRaise="@((int amountTo) =>
                            RecordActionAsync(loaded.Hand.HandId, HandActionType.Raise, amountTo))"
                        OnFinish="@((Guid winnerId) => FinishHandAsync(loaded.Hand.HandId, winnerId))"
                        OnAbort="@(() => AbortHandAsync(loaded.Hand.HandId))"
                        MyParticipantId="@Session.ParticipantIdFor(GameId)" />
                }

            </MudStack>
            break;
        case Failed(var message):
            <MudStack>
                <MudAlert Severity="Severity.Error">@message</MudAlert>
                <MudButton OnClick="LoadAsync" Variant="Variant.Filled" Color="Color.Primary">
                    Refresh
                </MudButton>
            </MudStack>
            break;
    }
</MudContainer>

@code {
    // TODO: add bunit tests
    [Parameter]
    public Guid GameId { get; set; }
    private readonly CancellationTokenSource _cts = new();
    private IPageState _state = new Loading();
    private bool _isBusy;
    private bool _isLoading;
    private IDisposable? _gameSubscription;
    private Guid? _currentHandId;
    private IDisposable? _handSubscription;

    protected override void OnInitialized()
    {
        _gameSubscription = HubConnection.OnGameUpdated(_ => InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        }));

        _handSubscription = HubConnection.OnHandActionEffectReceived(effect => InvokeAsync(async () =>
        {
            if (_state is Loaded { Hand: { } hand } loaded && effect.ActionNumber == hand.LastActionNumber + 1)
            {
                _state = loaded with { Hand = HandEffectProjection.Apply(hand, effect) };
                StateHasChanged();
            }
            else
            {
                await LoadAsync();
                StateHasChanged();
            }
        }));
    }

    protected override async Task OnParametersSetAsync()
    {
        await HubConnection.JoinGameAsync(GameId, _cts.Token);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_isLoading)
        {
            return;
        }

        _isLoading = true;
        try
        {
            _state = await LoadStateAsync();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task<IPageState> LoadStateAsync()
    {
        ApiResult<GameStateResponse> gameResult = await GameplayApi.GetGameStateAsync(GameId, _cts.Token);
        if (!gameResult.IsSuccess)
        {
            return new Failed(gameResult.Error.Message);
        }

        Guid? currentHandId = gameResult.Value.CurrentHandId;
        if (currentHandId is null)
        {
            if (_currentHandId is not null)
            {
                await HubConnection.LeaveHandAsync(_currentHandId.Value, _cts.Token);
                _currentHandId = null;
            }

            return new Loaded(gameResult.Value, null);
        }

        ApiResult<GetHandStateResponse> handResult =
            await GameplayApi.GetHandStateAsync(currentHandId.Value, _cts.Token);
        if (handResult.IsSuccess)
        {
            if (_currentHandId is null || _currentHandId != currentHandId)
            {
                if (_currentHandId is not null)
                {
                    await HubConnection.LeaveHandAsync(_currentHandId.Value, _cts.Token);
                }

                _currentHandId = currentHandId;
                await HubConnection.JoinHandAsync(_currentHandId.Value, _cts.Token);
            }

            return new Loaded(gameResult.Value, handResult.Value);
        }

        return new Failed(handResult.Error.Message);
    }

    private Task StartHandAsync() =>
        RunAsParticipantAsync((myId, ct) => GameplayApi.StartHandAsync(GameId, new StartHandRequest(myId), ct));

    private Task RecordActionAsync(Guid handId, HandActionType type, int? amount) =>
        RunAsParticipantAsync((myId, ct) => GameplayApi.RecordActionAsync(handId, new(myId, type, amount), ct));

    private Task FinishHandAsync(Guid handId, Guid winnerId) =>
        RunAsParticipantAsync((myId, ct) => GameplayApi.FinishHandAsync(handId, new(myId, winnerId), ct));

    private Task AbortHandAsync(Guid handId) =>
        RunAsParticipantAsync((myId, ct) => GameplayApi.AbortHandAsync(handId, new(myId), ct));

    private Task FinishGameAsync() =>
        RunAsParticipantAsync((myId, ct) => GameplayApi.FinishGameAsync(GameId, new(myId), ct));

    private async Task CreateParticipantAsync(string name)
    {
        ApiResult<AddParticipantResponse>? result =
            await RunAsync(ct => GameplayApi.AddParticipantAsync(GameId, new(name), ct));

        if (result is { IsSuccess: true })
        {
            Session.Set(GameId, result.Value.ParticipantId);
        }
    }

    private Task<TResult?> RunAsParticipantAsync<TResult>(Func<Guid, CancellationToken, Task<TResult>> callApiAsync)
        where TResult : ApiResult =>
        Session.ParticipantIdFor(GameId) is { } myId
            ? RunAsync(ct => callApiAsync(myId, ct))
            : Task.FromResult<TResult?>(null);

    private async Task<TResult?> RunAsync<TResult>(Func<CancellationToken, Task<TResult>> callApiAsync)
        where TResult : ApiResult
    {
        if (_isBusy)
        {
            return null;
        }

        _isBusy = true;
        try
        {
            TResult result = await callApiAsync(_cts.Token);

            if (!result.IsSuccess)
            {
                Snackbar.Add(result.Error.Message, Severity.Error);
            }

            return result;
        }
        finally
        {
            _isBusy = false;
        }
    }

    public void Dispose()
    {
        _gameSubscription?.Dispose();
        _handSubscription?.Dispose();
        _cts.Cancel();
        _cts.Dispose();
    }

    private interface IPageState;

    private sealed record Loading : IPageState;

    private sealed record Loaded(GameStateResponse Game, GetHandStateResponse? Hand) : IPageState;

    private sealed record Failed(string Message) : IPageState;
}
