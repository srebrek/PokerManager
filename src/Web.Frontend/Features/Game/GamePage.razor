@page "/games/{GameId:guid}"

@using Contracts.Api.Gameplay
@using static Web.Frontend.Features.Game.GameStateLoader

@implements IAsyncDisposable

@inject IGameplayApi GameplayApi
@inject ParticipantSession Session
@inject ISnackbar Snackbar
@inject GameHubConnection HubConnection
@inject IDialogService DialogService
@inject NavigationManager Navigation

<PageTitle>Game</PageTitle>

<MudStack>
    <MudStack Row>
        <MudButton
            OnClick="FinishGameAsync"
            Variant="Variant.Filled"
            Color="Color.Secondary"
            FullWidth
            data-testid="finish-game">
            Finish Game
        </MudButton>

        <MudButton
            OnClick="StartHandAsync"
            Variant="Variant.Filled"
            Color="Color.Primary"
            FullWidth
            data-testid="start-hand">
            Start Hand
        </MudButton>

        <MudButton
            OnClick="RefreshAsync"
            Variant="Variant.Outlined"
            Color="Color.Primary"
            FullWidth>
            Refresh
        </MudButton>
    </MudStack>

    @switch (_loader.State)
    {
        case Loading:
            <MudSkeleton />
            break;
        case Loaded { Game.IsFinished: true }:
            <MudSkeleton />
            break;
        case Loaded loaded:
            @if (loaded.Hand is null)
            {
                <LobbyPanel
                    Game="loaded.Game"
                    MyParticipantId="@Session.ParticipantIdFor(GameId)"
                    OnParticipantCreated="CreateParticipantAsync"
                    OnParticipantClaimed="ClaimParticipant"
                    OnRebuyRequested="@(participantId => RebuyAsync(loaded.Game, participantId))"
                    OnMoveDownRequested="MoveParticipantDownAsync"
                    OnSittingOutRequested="SetParticipantSittingOutAsync"
                    OnDealerButtonRequested="MoveDealerButtonAsync"
                    OnRulesRequested="@(() => ChangeRulesAsync(loaded.Game))" />
            }
            else if (loaded.Hand.Street is Street.Finished)
            {
                <HandSummaryPanel
                    Hand="loaded.Hand"
                    Participants="loaded.Game.Participants"
                    OnWinnersDeclared="@(winners => DeclareWinnersAsync(loaded.Hand.HandId, winners))"
                    OnFinish="@(() => FinishHandAsync(loaded.Hand.HandId))"
                    OnAbort="@(() => AbortHandAsync(loaded.Hand.HandId))"
                    OnUndo="@(() => UndoLastActionAsync(loaded.Hand.HandId))"
                    MyParticipantId="@Session.ParticipantIdFor(GameId)" />
            }
            else
            {
                <HandPanel
                    Hand="loaded.Hand"
                    SmallBlind="loaded.Game.SmallBlind"
                    Participants="loaded.Game.Participants"
                    OnAction="@(action => RecordActionAsync(loaded.Hand.HandId, action))"
                    OnPotsRequested="@(() => ShowPotsAsync(loaded.Game, loaded.Hand))"
                    OnAbort="@(() => AbortHandAsync(loaded.Hand.HandId))"
                    OnUndo="@(() => UndoLastActionAsync(loaded.Hand.HandId))"
                    MyParticipantId="@Session.ParticipantIdFor(GameId)" />
            }

            break;
        case Failed(var message):
            <MudAlert Severity="Severity.Error">@message</MudAlert>
            break;
    }
</MudStack>


@code {
    // TODO: add bunit tests
    [Parameter]
    public Guid GameId { get; set; }
    private readonly CancellationTokenSource _cts = new();
    private bool _isBusy;
    private IDisposable? _gameSubscription;
    private IDisposable? _handSubscription;
    private IDisposable? _handUpdatedSubscription;
    private IDisposable? _reconnectedSubscription;

    private GameStateLoader _loader = null!;

    protected override void OnInitialized()
    {
        _loader = new GameStateLoader(GameplayApi, HubConnection);

        _gameSubscription = HubConnection.OnGameUpdated(_ => InvokeAsync(async () =>
        {
            await _loader.OnGameUpdatedAsync();
            RedirectIfFinished();
            StateHasChanged();
        }));

        _handSubscription = HubConnection.OnHandActionEffectReceived(effect => InvokeAsync(async () =>
        {
            await _loader.OnHandActionEffectAsync(effect);
            RedirectIfFinished();
            StateHasChanged();
        }));

        _handUpdatedSubscription = HubConnection.OnHandUpdated(_ => InvokeAsync(async () =>
        {
            await _loader.LoadAsync();
            RedirectIfFinished();
            StateHasChanged();
        }));

        _reconnectedSubscription = HubConnection.OnReconnected(() => InvokeAsync(async () =>
        {
            await _loader.ResubscribeAsync();
            RedirectIfFinished();
            StateHasChanged();
        }));
    }

    protected override async Task OnParametersSetAsync()
    {
        await _loader.EnterGameAsync(GameId);
        RedirectIfFinished();
    }

    private async Task RefreshAsync()
    {
        await _loader.LoadAsync();
        RedirectIfFinished();
    }

    private void RedirectIfFinished()
    {
        if (_loader.State is Loaded { Game.IsFinished: true })
        {
            Navigation.NavigateTo($"/games/{GameId}/summary");
        }
    }

    private Task StartHandAsync() =>
        RunAsParticipantAsync((myId, ct) => GameplayApi.StartHandAsync(GameId, new StartHandRequest(myId), ct));

    private Task RecordActionAsync(Guid handId, HandPanel.HandActionSelected action) =>
        RunAsync(ct => GameplayApi.RecordActionAsync(
            handId, new(action.ActingParticipantId, action.Type, action.AmountTo), ct));

    private async Task ShowPotsAsync(GameStateResponse game, GetHandStateResponse hand)
    {
        DialogParameters<PotsDialog> parameters = new()
        {
            { d => d.Pots, hand.Pots },
            { d => d.Participants, game.Participants }
        };

        await DialogService.ShowAsync<PotsDialog>("Pots", parameters);
    }

    private Task DeclareWinnersAsync(Guid handId, IReadOnlyList<PotWinner> winners) =>
        RunAsParticipantAsync((myId, ct) => GameplayApi.DeclareWinnersAsync(handId, new(myId, winners), ct));

    private Task FinishHandAsync(Guid handId) =>
        RunAsParticipantAsync((myId, ct) => GameplayApi.FinishHandAsync(handId, new(myId), ct));

    private Task AbortHandAsync(Guid handId) =>
        RunAsParticipantAsync((myId, ct) => GameplayApi.AbortHandAsync(handId, new(myId), ct));

    private Task UndoLastActionAsync(Guid handId) =>
        RunAsParticipantAsync((myId, ct) => GameplayApi.UndoLastActionAsync(handId, new(myId), ct));

    private async Task RebuyAsync(GameStateResponse game, Guid participantId)
    {
        DialogParameters<RebuyDialog> parameters = new()
        {
            { d => d.ParticipantName, game.Participants.Single(p => p.Id == participantId).Name }
        };

        IDialogReference dialog = await DialogService.ShowAsync<RebuyDialog>("Rebuy", parameters);
        DialogResult? result = await dialog.Result;

        if (result is { Canceled: false, Data: int amount })
        {
            await RunAsParticipantAsync((myId, ct) =>
                GameplayApi.RebuyAsync(GameId, participantId, new(myId, amount), ct));
        }
    }

    private async Task ChangeRulesAsync(GameStateResponse game)
    {
        DialogParameters<RulesDialog> parameters = new()
        {
            { d => d.SmallBlind, game.SmallBlind },
            { d => d.BigBlind, game.BigBlind }
        };

        IDialogReference dialog = await DialogService.ShowAsync<RulesDialog>("Rules", parameters);
        DialogResult? result = await dialog.Result;

        if (result is { Canceled: false, Data: RulesDialog.Rules rules })
        {
            await RunAsParticipantAsync((myId, ct) => GameplayApi.ChangeGameRulesAsync(
                GameId, new(myId, rules.SmallBlind, rules.BigBlind), ct));
        }
    }

    private Task MoveParticipantDownAsync(Guid? participantId)
    {
        if (participantId is null)
        {
            Snackbar.Add("No participant is selected.", Severity.Warning);
            return Task.CompletedTask;
        }

        return RunAsParticipantAsync((myId, ct) =>
            GameplayApi.MoveParticipantDownAsync(GameId, participantId.Value, new(myId), ct));
    }

    private Task SetParticipantSittingOutAsync(LobbyPanel.SittingOutRequested request) =>
        RunAsParticipantAsync((myId, ct) => GameplayApi.SetParticipantSittingOutAsync(
            GameId, request.ParticipantId, new(myId, request.IsSittingOut), ct));

    private Task MoveDealerButtonAsync(Guid participantId) =>
        RunAsParticipantAsync((myId, ct) =>
            GameplayApi.MoveDealerButtonAsync(GameId, new(myId, participantId), ct));

    private Task FinishGameAsync() =>
        RunAsParticipantAsync((myId, ct) => GameplayApi.FinishGameAsync(GameId, new(myId), ct));

    private async Task CreateParticipantAsync(string name)
    {
        ApiResult<AddParticipantResponse>? result =
            await RunAsync(ct => GameplayApi.AddParticipantAsync(GameId, new(name), ct));

        if (result is { IsSuccess: true })
        {
            Session.Set(GameId, result.Value.ParticipantId);
        }
    }

    private void ClaimParticipant(Guid participantId) => Session.Set(GameId, participantId);

    private Task<TResult?> RunAsParticipantAsync<TResult>(Func<Guid, CancellationToken, Task<TResult>> callApiAsync)
        where TResult : ApiResult =>
        Session.ParticipantIdFor(GameId) is { } myId
            ? RunAsync(ct => callApiAsync(myId, ct))
            : Task.FromResult<TResult?>(null);

    private async Task<TResult?> RunAsync<TResult>(Func<CancellationToken, Task<TResult>> callApiAsync)
        where TResult : ApiResult
    {
        if (_isBusy)
        {
            return null;
        }

        _isBusy = true;
        try
        {
            TResult result = await callApiAsync(_cts.Token);

            if (!result.IsSuccess)
            {
                Snackbar.Add(result.Error.Message, Severity.Error);
            }

            return result;
        }
        finally
        {
            _isBusy = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _gameSubscription?.Dispose();
        _handSubscription?.Dispose();
        _handUpdatedSubscription?.Dispose();
        _reconnectedSubscription?.Dispose();

        await _loader.DisposeAsync();

        await _cts.CancelAsync();
        _cts.Dispose();
    }
}
