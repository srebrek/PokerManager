@using Contracts.Api.Gameplay

<MudPaper data-testid="seat-card">
    <MudStack Row>
        <MudText Color="@(Model.IsMe ? Color.Primary : Color.Inherit)" data-testid="seat-name">
            @Model.Name
        </MudText>

        <MudText data-testid="seat-state">
            State: @Model.State
        </MudText>

        <MudText data-testid="seat-chips">
            Chips: @Model.RemainingStack
        </MudText>

        <MudSpacer />

        <MudText data-testid="seat-bet">
            Bet: @Model.Contribution
        </MudText>
    </MudStack>
</MudPaper>

@code {
    [Parameter]
    [EditorRequired]
    public required SeatCardModel Model { get; set; }

    public sealed record SeatCardModel(
        string Name,
        int RemainingStack,
        int Contribution,
        SeatState State,
        bool IsMe);
}
