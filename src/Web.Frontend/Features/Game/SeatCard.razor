@using Contracts.Api.Gameplay

<MudPaper>
    <MudButton OnClick="ClickAsync" Variant="Variant.Outlined" Color="@(IsSelected ? Color.Warning : Color.Inherit)">
        <MudStack Row>
            <MudText Color="@(Model.IsMe ? Color.Primary : Color.Inherit)">
                @Model.Name
            </MudText>

            <MudText>
                State: @Model.State
            </MudText>

            <MudText>
                Chips: @Model.RemainingStack
            </MudText>

            <MudSpacer />

            <MudText>
                Bet: @Model.Contribution
            </MudText>
        </MudStack>
    </MudButton>
</MudPaper>

@code {
    [Parameter]
    [EditorRequired]
    public required SeatCardModel Model { get; set; }

    [Parameter]
    [EditorRequired]
    public EventCallback<Guid> OnClick { get; set; }

    [Parameter]
    [EditorRequired]
    public bool IsSelected { get; set; }

    public sealed record SeatCardModel(
        Guid ParticipantId,
        string Name,
        int RemainingStack,
        int Contribution,
        SeatState State,
        bool IsMe);

    private async Task ClickAsync() => await OnClick.InvokeAsync(Model.ParticipantId);
}
