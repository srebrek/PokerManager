@using System.ComponentModel.DataAnnotations
@using Contracts.Api.Gameplay
@inject IGameplayApi GameplayApi

<EditForm Model="@_model" OnValidSubmit="OnValidSubmit">
    <DataAnnotationsValidator />

    <MudStack Spacing="3">

        <MudText Typo="Typo.h4">Find Game</MudText>

        <MudTextField @bind-Value="_model.JoinCode" For="@(() => _model.JoinCode)" Label="Join Code" />

        <MudButton
            ButtonType="ButtonType.Submit"
            Variant="Variant.Filled"
            Color="Color.Primary"
            Disabled="_submitting"
            data-testid="find-game-submit">
            Find
        </MudButton>

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error">@_error</MudAlert>
        }

    </MudStack>
</EditForm>

@code {
    [Parameter]
    [EditorRequired]
    public EventCallback<GameFound> OnFound { get; set; }
    private readonly FindGameModel _model = new();
    private bool _submitting;
    private string? _error;

    private async Task OnValidSubmit()
    {
        _submitting = true;
        _error = null;

        ApiResult<GameLookupResponse> result = await GameplayApi.GetGameByJoinCodeAsync(_model.JoinCode);

        if (result.IsSuccess)
        {
            await OnFound.InvokeAsync(new(result.Value.GameId));
            return;
        }

        _error = result.Error.Message;
        _submitting = false;
    }

    internal sealed class FindGameModel
    {
        [Required]
        [Length(6, 6)]
        public string JoinCode { get; set; } = string.Empty;
    }

    public readonly record struct GameFound(Guid GameId);
}
