@page "/login"
@using Contracts.Api.Authentication
@inject HttpClient Http
@inject CookieAuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Login</PageTitle>

<MudGrid Justify="Justify.Center">
    <MudItem xs="12" sm="6" md="4">
        <MudPaper Class="pa-6">
            <MudText Typo="Typo.h5" Class="mb-4">Login</MudText>
            <MudForm @ref="_form">
                <MudTextField @bind-Value="_email" Label="Email" InputType="InputType.Email" Required="true"
                              autocomplete="email" Class="mb-3" />
                <MudTextField @bind-Value="_password" Label="Password" InputType="InputType.Password" Required="true"
                              autocomplete="current-password" Class="mb-3" />
                <MudCheckBox @bind-Value="_rememberMe" Label="Remember me" Class="mb-3" />
                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert>
                }
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                           Disabled="_isSubmitting" OnClick="HandleLogin">
                    @if (_isSubmitting)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    Login
                </MudButton>
            </MudForm>
            <MudText Class="mt-3">
                Don't have an account? <MudLink Href="/register">Register</MudLink>
            </MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private MudForm _form = default!;
    private string _email = string.Empty;
    private string _password = string.Empty;
    private bool _rememberMe;
    private bool _isSubmitting;
    private string? _error;

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private async Task HandleLogin()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid || _isSubmitting)
        {
            return;
        }

        _isSubmitting = true;
        _error = null;

        try
        {
            using HttpResponseMessage response = await Http.PostAsJsonAsync(
                "identity/login",
                new LoginRequest(_email, _password, _rememberMe));

            if (response.IsSuccessStatusCode)
            {
                AuthStateProvider.NotifyAuthenticationStateChanged();
                Navigation.NavigateTo(SafeReturnUrl());
                return;
            }

            _error = await ApiErrorReader.ReadMessageAsync(response)
                ?? "Invalid email or password.";
        }
        catch (HttpRequestException)
        {
            _error = "Unable to reach the server. Check your connection and try again.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    // Only allow app-relative return URLs to prevent open redirects.
    private string SafeReturnUrl() =>
        ReturnUrl is not null && Uri.IsWellFormedUriString(ReturnUrl, UriKind.Relative)
            ? $"/{ReturnUrl.TrimStart('/')}"
            : "/";
}
