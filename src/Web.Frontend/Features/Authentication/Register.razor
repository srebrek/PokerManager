@page "/register"
@using Contracts.Api.Authentication
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Register</PageTitle>

<MudGrid Justify="Justify.Center">
    <MudItem xs="12" sm="6" md="4">
        <MudPaper Class="pa-6">
            <MudText Typo="Typo.h5" Class="mb-4">Register</MudText>
            <MudForm @ref="_form">
                <MudTextField @bind-Value="_email" Label="Email" InputType="InputType.Email" Required="true"
                              autocomplete="email" Class="mb-3" />
                <MudTextField @bind-Value="_password" Label="Password" InputType="InputType.Password" Required="true"
                              autocomplete="new-password" Class="mb-3" />
                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert>
                }
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                           Disabled="_isSubmitting" OnClick="HandleRegister">
                    @if (_isSubmitting)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    Register
                </MudButton>
            </MudForm>
            <MudText Class="mt-3">
                Already have an account? <MudLink Href="/login">Login</MudLink>
            </MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private MudForm _form = default!;
    private string _email = string.Empty;
    private string _password = string.Empty;
    private bool _isSubmitting;
    private string? _error;

    private async Task HandleRegister()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid || _isSubmitting)
        {
            return;
        }

        _isSubmitting = true;
        _error = null;

        try
        {
            using HttpResponseMessage response = await Http.PostAsJsonAsync(
                "identity/register",
                new RegisterRequest(_email, _password));

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Account created. You can sign in now.", Severity.Success);
                Navigation.NavigateTo("/login");
                return;
            }

            _error = await ApiErrorReader.ReadMessageAsync(response)
                ?? "Registration failed. Please check your details and try again.";
        }
        catch (HttpRequestException)
        {
            _error = "Unable to reach the server. Check your connection and try again.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
