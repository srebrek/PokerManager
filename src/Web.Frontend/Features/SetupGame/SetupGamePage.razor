@page "/"
@page "/games/setup"
@using Contracts.Api.Gameplay
@using Web.Frontend.Features.CreateGame
@using Web.Frontend.Features.FindGame

@inject NavigationManager Nav
@inject ParticipantSession Session

<MudStack>
    <CreateGameForm OnCreated="HandleGameCreated" />
    <FindGameForm OnFound="HandleGameFound" />
</MudStack>

@code {
    private void HandleGameCreated(CreateGameForm.GameCreated gameCreated)
    {
        Session.Set(gameCreated.GameId, gameCreated.ParticipantId);
        Nav.NavigateTo($"/games/{gameCreated.GameId}");
    }

    private void HandleGameFound(FindGameForm.GameFound gameFound) =>
        Nav.NavigateTo($"/games/{gameFound.GameId}");
}
