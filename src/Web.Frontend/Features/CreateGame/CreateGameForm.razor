@using System.ComponentModel.DataAnnotations
@using Contracts.Api.Gameplay

@inject IGameplayApi GameplayApi

<EditForm Model="@_model" OnValidSubmit="OnValidSubmit">
    <DataAnnotationsValidator/>

    <MudStack Spacing="3">

        <MudText Typo="Typo.h4">New Game</MudText>

        <MudTextField @bind-Value="_model.HostName" For="@(() => _model.HostName)" Label="Your Name"/>

        <MudButton
            ButtonType="ButtonType.Submit"
            Variant="Variant.Filled"
            Color="Color.Primary"
            Disabled="_submitting">
            Create
        </MudButton>

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error">@_error</MudAlert>
        }

    </MudStack>
</EditForm>

@code {
    [Parameter]
    public EventCallback<GameCreated> OnCreated { get; set; }
    private readonly CreateGameModel _model = new();
    private bool _submitting;
    private string? _error;

    private async Task OnValidSubmit()
    {
        _submitting = true;
        _error = null;

        GameplayResult<CreateGameResponse> result = await GameplayApi.CreateGameAsync(_model.ToRequest());

        if (result.IsSuccess)
        {
            await OnCreated.InvokeAsync(new(result.Value!.GameId, result.Value!.ParticipantId));
            return;
        }

        _error = result.Error;
        _submitting = false;
    }

    internal sealed class CreateGameModel
    {
        [Required]
        public string HostName { get; set; } = string.Empty;

        public CreateGameRequest ToRequest() => new(HostName);
    }

    public readonly record struct GameCreated(Guid GameId, Guid ParticipantId);
}
