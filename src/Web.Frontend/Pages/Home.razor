@page "/"

<PageTitle>Home</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Welcome to PokerManager</MudText>

<AuthorizeView>
    <Authorized>
        <MudText>You are logged in as <strong>@context.User.Identity?.Name</strong>.</MudText>
    </Authorized>
    <NotAuthorized>
        <MudText>Please <MudLink Href="/login">log in</MudLink> or <MudLink Href="/register">register</MudLink>.</MudText>
    </NotAuthorized>
</AuthorizeView>
